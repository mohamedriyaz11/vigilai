# VigilAI Environment Variables Configuration Example
# Copy this file to .env and adjust variables as needed.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Dashboard Authentication Token (Required for web UI access)
VIGILAI_DASHBOARD_TOKEN=vigil-dev-token-change-in-production

# Optional Cloud LLM Configuration (Disabled by default)
# Only structured text events are transmitted when enabled; video frames NEVER leave device.
VIGILAI_CLOUD_LLM_ENABLED=false
VIGILAI_CLOUD_LLM_PROVIDER=openai
VIGILAI_CLOUD_LLM_API_KEY=
VIGILAI_CLOUD_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
VIGILAI_CLOUD_LLM_MODEL=gpt-4o-mini

# Hardware Serial Communication (Optional for physical ESP32)
VIGILAI_SERIAL_PORT=COM5
VIGILAI_SERIAL_BAUD=115200

# Camera Index (0 for default USB webcam)
VIGILAI_CAMERA_INDEX=0
